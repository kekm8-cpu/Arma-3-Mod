// ------------------------------------------------------------------------ //
// BATTLE COMMAND CONTEXT MENU                                               //
// ------------------------------------------------------------------------ //
// The right-click menu the map's command mode opens over a selection. CONTROL
// CLASSES rather than a dialog class: TACT_fnc_openContextMenu ctrlCreates
// these onto display 12, the map's own display, so the map keeps its input and
// z-order settles itself - see manifest section 14.
//
// Sizes are in the UI coordinate space ctrlSetPosition uses, which is the space
// the mouse handlers report in, so the menu opens exactly at the cursor. The
// figures are in init.sqf as fractions of the safe zone.
//
// COLOUR LIVES HERE, unlike the rest of the layer's presentation: a config
// class cannot read a mission variable, and a colour declared in both places
// will eventually disagree with itself. The map's DRAWN colours stay in
// init.sqf; the menu's are these.

// The backing plate. Pale, and one margin larger than the rows on every side,
// so what shows around them reads as a thin border rather than as a gap.
class TACT_RscMenuFrame {
    idc = -1;
    type = 0;                        // CT_STATIC
    style = 0;                       // ST_LEFT
    x = 0; y = 0; w = 0; h = 0;      // Set at creation; these are placeholders
    text = "";
    font = "PuristaMedium";
    sizeEx = 0.032;
    shadow = 0;
    colorText[] = {1, 1, 1, 1};
    colorBackground[] = {0.85, 0.87, 0.90, 0.75};
};

// One row. A button rather than a static with a click handler, because the
// engine already highlights a button under the pointer - colorBackgroundActive
// is the hover state.
//
// The offsets and sounds are zeroed deliberately: a stock button slides down a
// pixel when pressed, and a row that moves under the cursor as it is chosen is
// a row that can be missed.
class TACT_RscMenuButton {
    idc = -1;
    type = 1;                        // CT_BUTTON
    style = 2;                       // ST_CENTER
    x = 0; y = 0; w = 0; h = 0;      // Set at creation; these are placeholders
    text = "";
    action = "";
    font = "PuristaMedium";
    sizeEx = 0.032;
    shadow = 0;
    borderSize = 0;
    offsetX = 0; offsetY = 0;
    offsetPressedX = 0; offsetPressedY = 0;
    colorText[] = {1, 1, 1, 1};
    colorDisabled[] = {0.65, 0.65, 0.65, 0.6};
    colorBackground[] = {0.04, 0.05, 0.07, 0.92};
    colorBackgroundDisabled[] = {0.04, 0.05, 0.07, 0.6};
    colorBackgroundActive[] = {0.20, 0.28, 0.40, 1};
    colorFocused[] = {0.20, 0.28, 0.40, 1};
    colorShadow[] = {0, 0, 0, 0};
    colorBorder[] = {0, 0, 0, 0};
    soundClick[] = {"", 0, 1};
    soundEnter[] = {"", 0, 1};
    soundPush[] = {"", 0, 1};
    soundEscape[] = {"", 0, 1};
};

class CfgFunctions {
    class STRAT {
